{
    "name": "dokumentasi-presentasi",
    "version": "1.0.0",
    "private": true,
    "type": "module",
    "description": "Dokumentasi presentasi aplikasi, satu halaman A4 per fitur.",
    "scripts": {
        "build": "node build.mjs",
        "watch": "node build.mjs --watch",
        "capture": "node capture.mjs",
        "check": "node build.mjs && node periksa.mjs",
        "pdf": "node build.mjs && \"/Applications/Google Chrome.app/Contents/MacOS/Google Chrome\" --headless --disable-gpu --no-pdf-header-footer --print-to-pdf=dokumentasi.pdf dokumentasi.html"
    },
    "devDependencies": {
        "playwright-core": "^1.64.1"
    }
}
